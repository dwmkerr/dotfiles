# Source my personal (github.com/dwmkerr/dotfiles) configuration.
[ -r ~/.shell.sh ] && source ~/.shell.sh

[[ "$TERM_PROGRAM" == "kiro" ]] && . "$(kiro --locate-shell-integration-path zsh)"

autoload -U +X bashcompinit && bashcompinit
complete -o nospace -C /opt/homebrew/bin/terraform terraform

# zsh picks its keymap by inspecting VISUAL/EDITOR, and shell.sh sets both to
# "vi", which silently selects viins. There, ^N through ^P are self-insert, so
# they type themselves instead of moving through history, and ^W becomes
# vi-backward-kill-word. Declaring the keymap keeps it from depending on an
# editor preference, which is also why the two machines disagreed.
bindkey -e
